# Local development only. Copy this file to infrastructure/.env and change
# values if the defaults conflict with other services on your workstation.

CREVAFACTOS_POSTGRES_HOST=127.0.0.1
CREVAFACTOS_POSTGRES_PORT=5432
CREVAFACTOS_POSTGRES_DATABASE=crevafactos_local
CREVAFACTOS_POSTGRES_USERNAME=crevafactos
CREVAFACTOS_POSTGRES_PASSWORD=local_dev_only_change_me

# Application persistence settings. Keep these aligned with the PostgreSQL
# values above when overriding local defaults.
CREVAFACTOS__PERSISTENCE__ENABLED=true
CREVAFACTOS__PERSISTENCE__HEALTH_CHECKS_ENABLED=false
CREVAFACTOS__PERSISTENCE__HOST=127.0.0.1
CREVAFACTOS__PERSISTENCE__PORT=5432
CREVAFACTOS__PERSISTENCE__DATABASE=crevafactos_local
CREVAFACTOS__PERSISTENCE__USERNAME=crevafactos_runtime
CREVAFACTOS__PERSISTENCE__PASSWORD=local_runtime_only_change_me
CREVAFACTOS__PERSISTENCE__SSL_MODE=Disable
CREVAFACTOS__PERSISTENCE__CONNECTION_TIMEOUT_SECONDS=15
CREVAFACTOS__PERSISTENCE__COMMAND_TIMEOUT_SECONDS=30
CREVAFACTOS__PERSISTENCE__POOLING=true

# Explicit migration-only credentials. These must never be used by the API.
CREVAFACTOS__MIGRATIONS__HOST=127.0.0.1
CREVAFACTOS__MIGRATIONS__PORT=5432
CREVAFACTOS__MIGRATIONS__DATABASE=crevafactos_local
CREVAFACTOS__MIGRATIONS__USERNAME=crevafactos
CREVAFACTOS__MIGRATIONS__PASSWORD=local_dev_only_change_me
CREVAFACTOS__MIGRATIONS__SSL_MODE=Disable
CREVAFACTOS__MIGRATIONS__CONNECTION_TIMEOUT_SECONDS=15
CREVAFACTOS__MIGRATIONS__COMMAND_TIMEOUT_SECONDS=30

CREVAFACTOS_RABBITMQ_HOST=localhost
CREVAFACTOS_RABBITMQ_AMQP_PORT=5672
CREVAFACTOS_RABBITMQ_MANAGEMENT_PORT=15672
CREVAFACTOS_RABBITMQ_USERNAME=crevafactos
CREVAFACTOS_RABBITMQ_PASSWORD=local_dev_only_change_me
