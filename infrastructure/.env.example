# Local development only. Copy this file to infrastructure/.env and change
# values if the defaults conflict with other services on your workstation.

CREVAFACTOS_POSTGRES_HOST=localhost
CREVAFACTOS_POSTGRES_PORT=5432
CREVAFACTOS_POSTGRES_DATABASE=crevafactos_local
CREVAFACTOS_POSTGRES_USERNAME=crevafactos
CREVAFACTOS_POSTGRES_PASSWORD=local_dev_only_change_me

CREVAFACTOS_RABBITMQ_HOST=localhost
CREVAFACTOS_RABBITMQ_AMQP_PORT=5672
CREVAFACTOS_RABBITMQ_MANAGEMENT_PORT=15672
CREVAFACTOS_RABBITMQ_USERNAME=crevafactos
CREVAFACTOS_RABBITMQ_PASSWORD=local_dev_only_change_me
