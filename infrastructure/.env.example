# Local development only. Copy this file to infrastructure/.env and change
# values if the defaults conflict with other services on your workstation.
#
# Primary environment keys use the NEVAXIS_FACTOS_* prefix.
# Legacy CREVAFACTOS_* keys remain supported as deprecated fallbacks.

NEVAXIS_FACTOS_POSTGRES_HOST=127.0.0.1
NEVAXIS_FACTOS_POSTGRES_PORT=5432
NEVAXIS_FACTOS_POSTGRES_DATABASE=crevafactos_local
NEVAXIS_FACTOS_POSTGRES_USERNAME=crevafactos
NEVAXIS_FACTOS_POSTGRES_PASSWORD=local_dev_only_change_me

# Application persistence settings. Keep these aligned with the PostgreSQL
# values above when overriding local defaults.
NEVAXIS_FACTOS__PERSISTENCE__ENABLED=true
NEVAXIS_FACTOS__PERSISTENCE__HEALTH_CHECKS_ENABLED=false
NEVAXIS_FACTOS__PERSISTENCE__HOST=127.0.0.1
NEVAXIS_FACTOS__PERSISTENCE__PORT=5432
NEVAXIS_FACTOS__PERSISTENCE__DATABASE=crevafactos_local
NEVAXIS_FACTOS__PERSISTENCE__USERNAME=crevafactos_runtime
NEVAXIS_FACTOS__PERSISTENCE__PASSWORD=local_runtime_only_change_me
NEVAXIS_FACTOS__PERSISTENCE__SSL_MODE=Disable
NEVAXIS_FACTOS__PERSISTENCE__CONNECTION_TIMEOUT_SECONDS=15
NEVAXIS_FACTOS__PERSISTENCE__COMMAND_TIMEOUT_SECONDS=30
NEVAXIS_FACTOS__PERSISTENCE__POOLING=true

# Explicit migration-only credentials. These must never be used by the API.
NEVAXIS_FACTOS__MIGRATIONS__HOST=127.0.0.1
NEVAXIS_FACTOS__MIGRATIONS__PORT=5432
NEVAXIS_FACTOS__MIGRATIONS__DATABASE=crevafactos_local
NEVAXIS_FACTOS__MIGRATIONS__USERNAME=crevafactos
NEVAXIS_FACTOS__MIGRATIONS__PASSWORD=local_dev_only_change_me
NEVAXIS_FACTOS__MIGRATIONS__SSL_MODE=Disable
NEVAXIS_FACTOS__MIGRATIONS__CONNECTION_TIMEOUT_SECONDS=15
NEVAXIS_FACTOS__MIGRATIONS__COMMAND_TIMEOUT_SECONDS=30

# Deprecated legacy keys (backward-compatible fallback only):
# CREVAFACTOS_POSTGRES_HOST=127.0.0.1
# CREVAFACTOS__PERSISTENCE__ENABLED=true

# API authentication. Development mode is rejected outside the Development
# environment. Production JWT values are identity-provider metadata, not tokens.
NEVAXIS_FACTOS__AUTHENTICATION__MODE=Development
# NEVAXIS_FACTOS__AUTHENTICATION__AUTHORITY=https://identity.example.test/
# NEVAXIS_FACTOS__AUTHENTICATION__AUDIENCE=crevafactos-api
# NEVAXIS_FACTOS__AUTHENTICATION__REQUIRE_HTTPS_METADATA=true

NEVAXIS_FACTOS_RABBITMQ_HOST=localhost
NEVAXIS_FACTOS_RABBITMQ_AMQP_PORT=5672
NEVAXIS_FACTOS_RABBITMQ_MANAGEMENT_PORT=15672
NEVAXIS_FACTOS_RABBITMQ_USERNAME=crevafactos
NEVAXIS_FACTOS_RABBITMQ_PASSWORD=local_dev_only_change_me

# Dashboard market rates (read-only FX context). Leave NotConfigured unless you
# have a licensed Open Exchange Rates App ID.
# CREVAFACTOS__MARKET_RATES__PROVIDER_MODE=OpenExchangeRates
# CREVAFACTOS__MARKET_RATES__OPEN_EXCHANGE_RATES_APP_ID=
# CREVAFACTOS__MARKET_RATES__OPEN_EXCHANGE_RATES_BASE_URL=https://openexchangerates.org/api

# Optional WhatsApp Business (Meta Cloud API) — operational task delivery only.
# CREVAFACTOS__AI_TASK_DELIVERY__WHATSAPP__ENABLED=false
# CREVAFACTOS__AI_TASK_DELIVERY__WHATSAPP__PHONE_NUMBER_ID=
# CREVAFACTOS__AI_TASK_DELIVERY__WHATSAPP__BUSINESS_ACCOUNT_ID=
# CREVAFACTOS__AI_TASK_DELIVERY__WHATSAPP__ACCESS_TOKEN=
# CREVAFACTOS__AI_TASK_DELIVERY__WHATSAPP__APP_SECRET=
# CREVAFACTOS__AI_TASK_DELIVERY__WHATSAPP__WEBHOOK_VERIFY_TOKEN=
# CREVAFACTOS__AI_TASK_DELIVERY__WHATSAPP__DEFAULT_TEMPLATE_NAME=
# CREVAFACTOS__AI_TASK_DELIVERY__WHATSAPP__DEFAULT_TEMPLATE_LANGUAGE_CODE=tr
# CREVAFACTOS__AI_TASK_DELIVERY__WHATSAPP__TEST_API_BASE_URL=

# Optional Email (SMTP) — operational task delivery only.
# CREVAFACTOS__AI_TASK_DELIVERY__EMAIL__ENABLED=false
# CREVAFACTOS__AI_TASK_DELIVERY__EMAIL__SMTP__HOST=
# CREVAFACTOS__AI_TASK_DELIVERY__EMAIL__SMTP__PORT=587
# CREVAFACTOS__AI_TASK_DELIVERY__EMAIL__SMTP__SECURITY_MODE=starttls
# CREVAFACTOS__AI_TASK_DELIVERY__EMAIL__SMTP__USERNAME=
# CREVAFACTOS__AI_TASK_DELIVERY__EMAIL__SMTP__PASSWORD=
# CREVAFACTOS__AI_TASK_DELIVERY__EMAIL__SMTP__FROM_ADDRESS=
# CREVAFACTOS__AI_TASK_DELIVERY__EMAIL__SMTP__FROM_DISPLAY_NAME=CrevaFactOS
# CREVAFACTOS__AI_TASK_DELIVERY__EMAIL__SMTP__REPLY_TO_ADDRESS=
# CREVAFACTOS__AI_TASK_DELIVERY__EMAIL__TEST_SMTP__HOST=
# CREVAFACTOS__AI_TASK_DELIVERY__EMAIL__TEST_SMTP__PORT=

# infrastructure/.env.local (gitignored). Never commit real passwords here.
# DevelopmentSaasIdentity__Enabled=true
# CREVAFACTOS__AUTHENTICATION__MODE=SessionCookie
# DevelopmentSaasIdentity__TenantOwnerPassword=<SET_IN_INFRASTRUCTURE_ENV_LOCAL>
# DevelopmentSaasIdentity__MfaSharedSecret=<SET_IN_INFRASTRUCTURE_ENV_LOCAL>
# DevelopmentSaasIdentity__ActiveUserPassword=<SET_IN_INFRASTRUCTURE_ENV_LOCAL>
# DevelopmentSaasIdentity__DeactivatedUserPassword=<SET_IN_INFRASTRUCTURE_ENV_LOCAL>
# DevelopmentSaasIdentity__NoMembershipUserPassword=<SET_IN_INFRASTRUCTURE_ENV_LOCAL>
