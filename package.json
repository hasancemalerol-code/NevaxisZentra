{
  "name": "crevafactos",
  "version": "0.0.0",
  "private": true,
  "description": "AI Factory Operations Assistant and AI Production Manager monorepo.",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.18.0 <23",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @crevafactos/web dev",
    "dev:api": "dotnet run --project apps/api/CrevaFactOS.Api.csproj",
    "dev:worker": "dotnet run --project apps/worker/CrevaFactOS.Worker.csproj",
    "dev:edge-agent": "dotnet run --project apps/edge-agent/CrevaFactOS.EdgeAgent.csproj",
    "infra:config": "docker compose -f infrastructure/compose.yaml config",
    "infra:start": "docker compose -f infrastructure/compose.yaml up -d",
    "infra:stop": "docker compose -f infrastructure/compose.yaml stop",
    "infra:status": "docker compose -f infrastructure/compose.yaml ps",
    "infra:logs": "docker compose -f infrastructure/compose.yaml logs --tail=200",
    "infra:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/infrastructure/verify-local-infrastructure.ps1",
    "infra:reset": "docker compose -f infrastructure/compose.yaml down --volumes --remove-orphans",
    "db:config": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/database/database.ps1 config",
    "db:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/database/database.ps1 verify",
    "db:state": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/database/database.ps1 state",
    "db:tenant-isolation:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/database/database.ps1 tenant-isolation-verify",
    "db:authentication-membership:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/database/database.ps1 authentication-membership-verify",
    "db:permission-authorization:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/database/database.ps1 permission-authorization-verify",
    "auth:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/authentication/verify-local-authentication.ps1",
    "authorization:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/authorization/verify-local-authorization.ps1",
    "db:migrations:list": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/database/database.ps1 migrations-list",
    "db:migrations:add": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/database/database.ps1 migrations-add",
    "db:migrations:apply": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/database/database.ps1 migrations-apply",
    "db:migrations:rollback": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/database/database.ps1 migrations-rollback",
    "db:migrations:script": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/database/database.ps1 migrations-script",
    "build:web": "pnpm --filter @crevafactos/web build",
    "build:dotnet": "dotnet build CrevaFactOS.sln",
    "build": "pnpm run build:web && pnpm run build:dotnet",
    "lint": "pnpm --filter @crevafactos/web lint",
    "typecheck": "pnpm --filter @crevafactos/web typecheck",
    "test:web": "pnpm --filter @crevafactos/web test",
    "test:dotnet": "dotnet test CrevaFactOS.sln",
    "test": "pnpm run test:web && pnpm run test:dotnet",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  }
}
