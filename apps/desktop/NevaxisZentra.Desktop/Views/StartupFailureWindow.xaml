<Window x:Class="NevaxisZentra.Desktop.Views.StartupFailureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nevaxis Zentra"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Width="600"
        Height="480"
        Background="{StaticResource BrandBackgroundBrush}">
    <Border Padding="36">
        <StackPanel>
            <TextBlock Text="Nevaxis Zentra"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource BrandPrimaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="SummaryText"
                       Text="Nevaxis Zentra başlatılamadı."
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource BrandForegroundBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,24,0,8"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
            <TextBlock x:Name="ErrorCodeText"
                       FontFamily="Consolas"
                       FontSize="12"
                       Foreground="{StaticResource BrandMutedBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12" />
            <Expander Header="Teknik Ayrıntılar"
                      Margin="0,0,0,12">
                <ScrollViewer MaxHeight="120">
                    <TextBlock x:Name="DiagnosticsText"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="{StaticResource BrandForegroundBrush}"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Expander>
            <TextBlock x:Name="DiagnosticsBundleText"
                       FontSize="12"
                       Foreground="{StaticResource BrandMutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0">
                <Button Content="Yeniden Dene"
                        Width="140"
                        Height="36"
                        Margin="0,0,12,0"
                        Background="{StaticResource BrandPrimaryBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Click="RetryButton_Click" />
                <Button Content="Tanılama Paketi"
                        Width="150"
                        Height="36"
                        Margin="0,0,12,0"
                        Click="DiagnosticsButton_Click" />
                <Button Content="Kapat"
                        Width="120"
                        Height="36"
                        Click="CloseButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
