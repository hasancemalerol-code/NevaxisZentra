# CREVAFACTOS non-secret packaged runtime defaults.
# Secrets belong in %LOCALAPPDATA%\CrevaFactOS\config\runtime.env.local

CREVAFACTOS__PERSISTENCE__ENABLED=true
CREVAFACTOS__PERSISTENCE__HOST=127.0.0.1
CREVAFACTOS__PERSISTENCE__PORT=5433
CREVAFACTOS__PERSISTENCE__DATABASE=crevafactos_local
CREVAFACTOS__PERSISTENCE__USERNAME=crevafactos_runtime
CREVAFACTOS__PERSISTENCE__SSL_MODE=Disable
CREVAFACTOS__MIGRATIONS__USERNAME=crevafactos
CREVAFACTOS__AUTHENTICATION__MODE=SessionCookie
CREVAFACTOS_API_BASE_URL=http://127.0.0.1:5000
# Development Pilot canonical facility (apps/api/appsettings.Development.json → DevelopmentPilot:FacilityId)
CREVAFACTOS_FACILITY_ID=bb000001-0005-4000-8000-000000000005
CREVAFACTOS_DEV_FACILITY_ID=bb000001-0005-4000-8000-000000000005
