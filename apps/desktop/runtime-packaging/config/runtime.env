# NevaxisZentra non-secret packaged runtime defaults.
# Secrets belong in %LOCALAPPDATA%\NevaxisZentra\config\runtime.env.local

NEVAXIS_FACTOS__PERSISTENCE__ENABLED=true
NEVAXIS_FACTOS__PERSISTENCE__HOST=127.0.0.1
NEVAXIS_FACTOS__PERSISTENCE__PORT=55432
NEVAXIS_FACTOS__PERSISTENCE__DATABASE=crevafactos_local
NEVAXIS_FACTOS__PERSISTENCE__USERNAME=crevafactos_runtime
NEVAXIS_FACTOS__PERSISTENCE__SSL_MODE=Disable
NEVAXIS_FACTOS__MIGRATIONS__USERNAME=nevaxiszentra
NEVAXIS_FACTOS__AUTHENTICATION__MODE=SessionCookie
NEVAXIS_FACTOS_API_BASE_URL=http://127.0.0.1:5000
# Development Pilot canonical facility (apps/api/appsettings.Development.json → DevelopmentPilot:FacilityId)
NEVAXIS_FACTOS_FACILITY_ID=bb000001-0005-4000-8000-000000000005
NEVAXIS_FACTOS_DEV_FACILITY_ID=bb000001-0005-4000-8000-000000000005
