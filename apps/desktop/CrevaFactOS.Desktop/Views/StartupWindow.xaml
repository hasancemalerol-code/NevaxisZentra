<Window x:Class="CrevaFactOS.Desktop.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CrevaFactOS"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Width="520"
        Height="360"
        Background="{StaticResource BrandBackgroundBrush}">
    <Border BorderBrush="{StaticResource BrandBorderBrush}"
            BorderThickness="1"
            Padding="40">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="CREVAFACTOS"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource BrandPrimaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="AI Factory Operations OS"
                       FontSize="15"
                       Foreground="{StaticResource BrandMutedBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,32" />
            <ProgressBar IsIndeterminate="True"
                         Height="4"
                         Foreground="{StaticResource BrandPrimaryBrush}"
                         Background="{StaticResource BrandBorderBrush}" />
            <TextBlock x:Name="StatusText"
                       Text="Sistem hazırlanıyor"
                       FontSize="14"
                       Foreground="{StaticResource BrandForegroundBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0" />
        </StackPanel>
    </Border>
</Window>
