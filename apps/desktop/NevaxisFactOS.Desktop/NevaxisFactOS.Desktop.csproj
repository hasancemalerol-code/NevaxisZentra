<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\distribution\DesktopDistribution.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>NevaxisFactOS.Desktop</RootNamespace>
    <AssemblyName>NevaxisFactOS</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Brand\NevaxisFactOS-app-icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Version Condition="'$(DesktopDistributionVersion)' == ''">1.0.0</Version>
    <Version Condition="'$(DesktopDistributionVersion)' != ''">$(DesktopDistributionVersion)</Version>
    <AssemblyVersion Condition="'$(DesktopAssemblyVersion)' == ''">$(Version).0</AssemblyVersion>
    <AssemblyVersion Condition="'$(DesktopAssemblyVersion)' != ''">$(DesktopAssemblyVersion)</AssemblyVersion>
    <FileVersion Condition="'$(DesktopFileVersion)' == ''">$(AssemblyVersion)</FileVersion>
    <FileVersion Condition="'$(DesktopFileVersion)' != ''">$(DesktopFileVersion)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Product>$(DesktopDistributionProductName)</Product>
    <Company>$(DesktopDistributionPublisher)</Company>
    <DebugType Condition="'$(DesktopIncludeDebugSymbolsInPublish)' == 'true'">portable</DebugType>
    <DebugType Condition="'$(DesktopIncludeDebugSymbolsInPublish)' != 'true'">none</DebugType>
    <DebugSymbols Condition="'$(DesktopIncludeDebugSymbolsInPublish)' == 'true'">true</DebugSymbols>
    <DebugSymbols Condition="'$(DesktopIncludeDebugSymbolsInPublish)' != 'true'">false</DebugSymbols>
    <DesktopDevelopmentDistributionSwitch Condition="'$(DesktopDevelopmentDistribution)' == 'true'">-DevelopmentDistribution</DesktopDevelopmentDistributionSwitch>
    <DesktopDevelopmentDistributionSwitch Condition="'$(DesktopDevelopmentDistribution)' != 'true'"></DesktopDevelopmentDistributionSwitch>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NevaxisFactOS.Desktop.Tests" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <Target Name="GenerateDesktopBuildConfiguration" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <_GeneratedConfigPath>$(IntermediateOutputPath)DesktopBuildConfiguration.g.cs</_GeneratedConfigPath>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\scripts\generate-desktop-build-configuration.ps1&quot; -OutputPath &quot;$(_GeneratedConfigPath)&quot; -ProductionWebUrl &quot;$(DesktopProductionWebUrl)&quot; $(DesktopDevelopmentDistributionSwitch)" />
    <ItemGroup>
      <Compile Include="$(_GeneratedConfigPath)" />
    </ItemGroup>
  </Target>
</Project>
